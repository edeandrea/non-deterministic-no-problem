title Sequence: Tier 2 — Session Scoring (async, after the chat scope ends)

actor "User / Browser" as User

box "<$quarkus>\nParasol Application — request thread" #F9F9F9
	participant "<$robot>\nClaimService\n<i>@ChatScoped</i>" as ClaimService
	participant "ConversationalBaggageHandler" as Baggage
end box

box "<$quarkus>\nParasol Application — background worker" #EFF7EF
	participant "LangfuseSessionScoringService" as Scoring
	participant "ConversationExchange" as Exchange
	participant "<$robot>\nSessionSentimentService\n<i>model: session-sentiment</i>" as Sentiment
end box

participant "<$otel>\nOTel SDK /\nBatchSpanProcessor" as OTel #FFF3E0
participant "<$database>\nLangfuse\n<i>API + async ClickHouse ingest</i>" as Langfuse #F3E5F5
participant "<$brain>\nCohere\n<i>command-r7b-12-2024</i>" as Cohere #FFFFFF

' === THE FLOW ===

User -> ClaimService : chat over WebSocket /_chat/routes
activate ClaimService
ClaimService ->> OTel : emit spans\n<i>langchain4j.aiservices.ClaimService.chat</i>
ClaimService --> User : answer
deactivate ClaimService

note over OTel, Langfuse #EFEFEF
	Spans are exported in **batches** and Langfuse ingests them
	**asynchronously** into ClickHouse — they are NOT queryable
	the instant the conversation ends. That is why everything
	below has to wait and poll.
end note

User -> ClaimService : closes the chat scope
ClaimService -> Baggage : <<CDI>> ChatScopeEnded
activate Baggage
Baggage -> Baggage : ConversationTracker.remove(conversationId)
Baggage ->> Scoring : <<async>> Infrastructure.getDefaultExecutor()\n.execute(() -> scoreSession(conversationId))
deactivate Baggage

note right of Baggage #EFEFEF : User is already gone —\nnothing below is on the request path

activate Scoring
Scoring -> OTel : start INTERNAL span "ComputeSessionScore"\n(made current)

' --- WAIT FOR THE FLUSH ---
Scoring -> Scoring : delay quarkus.aiscoring.langfuse.session\n.otel-flush-wait-time (**5s**)

' --- POLL UNTIL READY ---
loop retry every 2s, expires after observation-max-wait-time (30s)
	Scoring -> Langfuse : async observations()\n.matching(sessionId, fields "core,basic,io,metadata")\n.findAll()
	activate Langfuse
	Langfuse --> Scoring : observations
	deactivate Langfuse
	alt no observation has BOTH input and output
		Scoring -> Scoring : fail with ObservationsNotReadyException\n-> retry with constant back-off
	else at least one complete observation
		Scoring -> Scoring : proceed
	end
end

note right of Scoring #FFF3E0
	On expiry: log "Gave up waiting", recover with an
	empty list — session scoring is best-effort and
	never breaks the application.
end note

' --- BUILD EXCHANGES ---
Scoring -> Exchange : hierarchyOf(observations)
activate Exchange
Exchange -> Exchange : index by id, keep observations with\nstartTime + input + output, sort by startTime,\nresolve dataset name\n<i>langchain4j.aiservices.&lt;Class&gt;.&lt;method&gt;</i>
Exchange --> Scoring : List<ConversationExchange>
deactivate Exchange

' --- DATASETS ---
group create-dataset-on-session-close (default true)
	Scoring -> Langfuse : datasets().createIfAbsent(...)\n**sequentially**, one per distinct dataset name
	Scoring -> Langfuse : datasetItems().create(...)\n**in parallel** (join all, fail fast, 30s cap)\ninput / expectedOutput = the model's own prior answer /\nsourceTraceId + metadata
	note right of Scoring : Failures are logged and swallowed
end

' --- SENTIMENT ---
group score-session (default true)
	Scoring -> Sentiment : evaluate(exchanges)
	activate Sentiment
	Sentiment -> Cohere : <<sync HTTP>> rate the conversation
	activate Cohere
	Cohere --> Sentiment : JSON verdict
	deactivate Cohere
	Sentiment -> Sentiment : SessionSentimentGuardrail\nextracts SessionSentiment(sentiment, reasoning)
	Sentiment --> Scoring : SessionSentiment
	deactivate Sentiment

	Scoring -> Langfuse : **synchronous** scores().create(\nsessionId, "session-sentiment",\nCATEGORICAL value, comment = reasoning)
	activate Langfuse
	Langfuse --> Scoring : ok
	deactivate Langfuse
	note right of Scoring : Deliberately synchronous so the score\nlands before the span is closed
end

Scoring -> OTel : end span "ComputeSessionScore" (finally)
deactivate Scoring

@enduml