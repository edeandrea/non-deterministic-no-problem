    {
      "type": "timeseries",
      "title": "Email latency",
      "description": "From the mailbox receiving an email to it leaving the processing folder, a review wait excluded. p50 and p95 by outcome.",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, outcome) (rate(claim_intake_email_latency_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{outcome}}",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(claim_intake_email_latency_milliseconds_bucket[$__rate_interval])))",
