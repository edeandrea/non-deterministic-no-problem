{
  "uid": "parasol-claim-intake",
  "title": "Parasol Claim Intake",
  "tags": [
    "parasol",
    "intake"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Parasol AI (intake agents)",
      "icon": "external link",
      "url": "/d/parasol-ai?var-ai_service=EmailClassifierAgent&var-ai_service=ClaimFollowUpAgent&var-ai_service=ClaimResolver&var-ai_service=ClaimSummaryAgent&var-ai_service=ClaimSentimentAgent&var-ai_service=IncidentDetailsAgent",
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "tooltip": "Tokens, latency, cost and guardrails, filtered to the intake's agents"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "What came in and what became of it",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Emails by outcome",
      "description": "What finally became of each email, counted once: a new claim, an update to a claim, a skipped auto-reply, a duplicate, a failure and so on.",
      "targets": [
        {
          "expr": "sum by (outcome) (increase(claim_intake_emails_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
